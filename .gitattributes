# Normalize line endings to LF in the repo, let working tree use the
# platform default (CRLF on Windows, LF on WSL/Linux). This avoids spurious
# diffs when switching between WSL and native Windows on the same checkout.
* text=auto

# Force LF for files that tooling always writes as LF (npm, cargo) so
# Windows checkouts don't trigger CRLF-conversion warnings on every
# lockfile bump.
*.json text eol=lf
*.lock text eol=lf
package-lock.json text eol=lf
Cargo.lock text eol=lf

# Shell scripts must be LF — bash chokes on CRLF (`bad interpreter`).
*.sh text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
